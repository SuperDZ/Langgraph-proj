        <Text style={{ fontSize: 150, fontWeight: 'bold', color: '#2563EB', lineHeight: 1 }}>
          495
        </Text>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E293B' }}>passed</Text>

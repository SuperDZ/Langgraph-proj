      <Box style={{ flex: 1, flexDirection: 'column', gap: 10, paddingTop: 18, paddingBottom: 14, paddingRight: 20 }}>
        <Box style={{ flexDirection: 'row', gap: 12 }}>
          <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#2563EB', marginTop: 8 }} />
          <Text style={{ fontSize: 16.5, color: '#1E293B', lineHeight: 1.5 }}>
            <span style={{ fontWeight: 'bold' }}>四级配置与不可变快照</span>：平台→部门→Agent→任务，工具/秘密/Capability 求交、deny 优先；恢复不换配置
          </Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 12 }}>
          <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#2563EB', marginTop: 8 }} />
          <Text style={{ fontSize: 16.5, color: '#1E293B', lineHeight: 1.5 }}>
            <span style={{ fontWeight: 'bold' }}>预算与后备模型链</span>：Token/成本预占结算、预算审批；仅超时/限流/不可用重试，严格 Schema 两次修复
          </Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 12 }}>
          <Box style={{ width: 6, height: 6, borderRadius: 3, background: '#2563EB', marginTop: 8 }} />
          <Text style={{ fontSize: 16.5, color: '#1E293B', lineHeight: 1.5 }}>
            <span style={{ fontWeight: 'bold' }}>Skills / MCP 真实接入</span>：隔离导入+人工绑定+包哈希锁定；MCP stdio/HTTP/SSE 客户端与逐次写审批
          </Text>
        </Box>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.4 }}>
          全量 <span style={{ color: '#F59E0B', fontWeight: 'bold' }}>383 passed</span>（80 专项 + 2 真实 Java 集成）· DeepSeek 在线预检 401，未采信在线质量
        </Text>
      </Box>
    </Box>
    <Box style={{ height: 218, flexDirection: 'row', gap: 22, background: '#F8FAFC', borderRadius: 12, overflow: 'hidden' }}>
      <Box style={{ width: 196, background: '#06B6D4', flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 8, padding: 16 }}>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>0.4.0</Text>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.3 }}>Phase 3</Text>
        <Text style={{ fontSize: 13, color: '#CFFAFE', lineHeight: 1.4, textAlign: 'center' }}>多角色研发
          <br />
          与受控发布</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 10, paddingTop: 18, paddingBottom: 14, paddingRight: 20 }}>
        <Box style={{ flexDirection: 'row', gap: 12 }}>

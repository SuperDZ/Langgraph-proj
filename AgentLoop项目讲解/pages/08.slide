      </Text>
      <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ height: 218, flexDirection: 'row', gap: 22, background: '#F8FAFC', borderRadius: 12, overflow: 'hidden' }}>
      <Box style={{ width: 196, background: '#2563EB', flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 8, padding: 16 }}>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>0.3.0</Text>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.3 }}>Phase 2</Text>
        <Text style={{ fontSize: 13, color: '#BFDBFE', lineHeight: 1.4, textAlign: 'center' }}>模型 / Skills / MCP

        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.4 }}>
          全量 <span style={{ color: '#F59E0B', fontWeight: 'bold' }}>457 passed</span>（74 三阶段用例 + 3 真实 Java 集成）· 权限取四级交集，deny 优先
        </Text>

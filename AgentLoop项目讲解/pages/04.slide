<Slide style={{ width: '1280px', height: '720px', padding: 60, background: '#FFFFFF' }}>
  <Box style={{ height: '100%', flexDirection: 'column', gap: 20 }}>
    <Box style={{ flexDirection: 'column', gap: 16 }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.2 }}>
        产品定位：四项设计承诺
      </Text>
      <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ height: 390, flexDirection: 'row', gap: 36 }}>
      <Box style={{ width: 340, flexDirection: 'column', gap: 18, paddingTop: 8 }}>
        <Text style={{ fontSize: 130, fontWeight: 'bold', color: '#2563EB', lineHeight: 1 }}>
          4
        </Text>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.3 }}>
          项不可随意改动的承诺
        </Text>
        <Box style={{ width: 88, height: 4, borderRadius: 2, background: '#F59E0B' }} />
        <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.6 }}>
          模拟软件组织的明确职责，不模拟无效的层层审批。
          <br />
          输入：Bug 报告 / 功能需求 / 技术改造；
          <br />
          输出：Spec、架构、代码、测试、安全、部署与复盘。
        </Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 14, justifyContent: 'center' }}>
        <Box style={{ flexDirection: 'row', gap: 18, alignItems: 'center', height: 82, background: '#F8FAFC', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#2563EB' }} />
          <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.3 }}>可配置</Text>
            <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.4 }}>模型 / Skills / MCP 按平台→部门→Agent→任务四级配置，取交集、deny 优先</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 18, alignItems: 'center', height: 82, background: '#F8FAFC', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#06B6D4' }} />
          <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.3 }}>可恢复</Text>
            <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.4 }}>LangGraph checkpoint + 幂等键 + 副作用对账，任意节点中断后可续跑</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 18, alignItems: 'center', height: 82, background: '#F8FAFC', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#F59E0B' }} />
          <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.3 }}>可审计</Text>
            <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.4 }}>不可变产物 + 追加事件 + 独立 GateResult，证据可回溯到版本与哈希</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 18, alignItems: 'center', height: 82, background: '#F8FAFC', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#2563EB' }} />
          <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.3 }}>可持续积累经验</Text>
            <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.4 }}>真人触发复盘，长期记忆人工审批后才进入正式命名空间</Text>
          </Box>
        </Box>
      </Box>
    </Box>
    <Box style={{ height: 56, borderRadius: 10, background: '#EFF6FF', flexDirection: 'row', alignItems: 'center', gap: 18, paddingLeft: 24, paddingRight: 24 }}>
      <Box style={{ width: 6, height: 28, borderRadius: 3, background: '#F59E0B' }} />
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.4 }}>
        质量结论只能来自确定性检查，不能来自模型自报
      </Text>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 14, color: '#64748B' }}>AgentLoop · 多 Agent 研发 Loop 平台</Text>
      <Text style={{ fontSize: 14, color: '#64748B' }}>04</Text>
    </Box>
  </Box>
</Slide>
